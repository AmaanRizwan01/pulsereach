# ==============================================================================
# 🤖 Pulsereach — Environment Configuration Template
# Copy this file to .env and fill in your verified credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE OAUTH2 APP CREDENTIALS (Shared Client ID & Secret)
# Create in Google Cloud Console with Sheets API, Drive API, and Gmail API enabled
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret

# ------------------------------------------------------------------------------
# 2. GOOGLE ACCOUNT 1: Storage & Database (Google Drive PDF Archive + Google Sheets)
# ------------------------------------------------------------------------------
GOOGLE_STORAGE_USER_EMAIL=your_storage_account@gmail.com
GOOGLE_STORAGE_REFRESH_TOKEN=your_storage_account_refresh_token_here
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# ------------------------------------------------------------------------------
# 3. GOOGLE ACCOUNT 2: Candidate Outreach (Gmail Draft & Send)
# ------------------------------------------------------------------------------
GMAIL_SENDER_EMAIL=your_outreach_email@gmail.com
GMAIL_REFRESH_TOKEN=your_outreach_gmail_refresh_token_here

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI ENGINE (Free Tier: 1,500 requests/day)
# Obtain free API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.6-flash
AI_MATCHING_MODEL=gemini-3.6-flash
AI_TAILORING_MODEL=gemini-3.6-flash
AI_CLASSIFIER_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 5. TELEGRAM INTERACTIVE MOBILE COCKPIT
# Obtain Bot Token from @BotFather, and Chat ID from @userinfobot or @getidsbot
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# 6. PIPELINE WEBHOOK & SECURITY
# Secret used to authenticate Google Apps Script onChange triggers at /api/trigger
# ------------------------------------------------------------------------------
WEBHOOK_SECRET=generate_a_secure_random_secret_here

# ------------------------------------------------------------------------------
# 7. OPTIONAL: GITHUB ACTIONS DISPATCH (Remote Worker Trigger)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=your_github_pat_token_here
GITHUB_OWNER=your-github-username
GITHUB_REPO=pulsereach

# ------------------------------------------------------------------------------
# 8. SUPABASE (Candidate Profile Storage & Auth)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your_project_id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 9. RUNTIME SETTINGS
# ------------------------------------------------------------------------------
CRON_SCHEDULE=0 */2 * * *
NODE_ENV=development
